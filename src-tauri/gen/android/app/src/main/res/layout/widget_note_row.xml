<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/widget_row_bg"
    android:orientation="vertical"
    android:paddingHorizontal="11dp"
    android:paddingVertical="7dp">

    <!-- first line: icon, title, time; the preview runs underneath from the icon's edge, full width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_fg"
            android:fontFamily="sans-serif-medium"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="5"
        android:textColor="@color/widget_dim"
        android:textSize="12sp" />
</LinearLayout>

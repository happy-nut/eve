<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_row">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape><solid android:color="@color/widget_row" /><corners android:radius="12dp" /></shape>
            </item>
            <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="12dp" /></shape></item>
        </selector>
    </item>
    <item android:id="@android:id/mask"><shape><solid android:color="#fff" /><corners android:radius="12dp" /></shape></item>
</ripple>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.eve" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Eve's blue for what Android draws itself in the page (the text cursor's handles, selection),
             not Material's default teal -->
        <item name="colorPrimary">#FF1E9BFF</item>
        <item name="colorSecondary">#FF1E9BFF</item>
        <item name="colorAccent">#FF1E9BFF</item>
        <item name="colorControlActivated">#FF1E9BFF</item>
        <item name="android:textColorHighlight">#551E9BFF</item>
    </style>
    <!-- the widget's "what to show" question: a small sheet over the home screen -->
    <style name="Theme.eve.Picker" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>

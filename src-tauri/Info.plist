<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Merged into the bundle's generated Info.plist. The file associations in tauri.conf.json only ever
    declare public.plain-text, but a .md file's own type is net.daringfireball.markdown: without that
    line Finder hands the icon (and the double-click) to whichever app does declare it, however often
    "Open .md files" is switched on.
    Eve can open them (Alternate), it does not claim them: as the Owner, with the app's icon for the
    file's, every .md on the Mac took Eve's icon the moment Eve was installed, "Open .md files" off.
    Switched on, that setting makes Eve the default itself (mac.rs, LSSetDefaultRoleHandlerForContentType);
    the files then show the system's document icon with Eve's on it, not the app's icon whole.
  -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Markdown</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>md</string>
        <string>markdown</string>
        <string>mdx</string>
      </array>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.daringfireball.markdown</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Plain text</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>txt</string>
      </array>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.plain-text</string>
      </array>
    </dict>
  </array>
  <!--
    eve://open?id=…[&section=…] shows that note: how `eve open` and the MCP server's open_note reach the
    Eve that is running (lib.rs). It only ever shows a note; it changes nothing.
  -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>dev.happynut.eve</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>eve</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
